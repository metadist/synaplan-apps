{
  "name": "synaplan-app",
  "version": "4.0.0",
  "private": true,
  "description": "Native iOS + Android shell for the Synaplan platform (Capacitor 8, bundled Vue SPA).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "./build.sh",
    "build:web": "./build.sh --web-only",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:ios": "cap run ios",
    "cap:android": "cap run android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "config:app": "node scripts/app-config.mjs",
    "config:app:print": "node scripts/app-config.mjs --print",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"capacitor.config.ts\" \"eslint.config.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"app/**/*.js\"",
    "format:check": "prettier --check \"capacitor.config.ts\" \"eslint.config.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"app/**/*.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "ci-local": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "check:release": "node scripts/release-drift.mjs --bootstrap",
    "check:release:strict": "node scripts/release-drift.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:drill": "node scripts/release-drill.mjs",
    "release:sync": "node scripts/sync-synaplan.mjs",
    "release:route": "node scripts/release-route.mjs",
    "openapi:fetch": "node scripts/fetch-openapi.mjs",
    "dev:shell": "node scripts/dev-shell.mjs",
    "e2e": "maestro test .maestro",
    "e2e:dev": "maestro test .maestro -e APP_ID=com.synaplan.app.dev",
    "e2e:staging": "maestro test .maestro -e APP_ID=com.synaplan.app.staging",
    "assets:generate": "capacitor-assets generate --ios --android --iconBackgroundColor '#003fc7' --iconBackgroundColorDark '#003fc7' --splashBackgroundColor '#003fc7' --splashBackgroundColorDark '#003fc7'",
    "ota:prepare": "node scripts/ota-prepare.mjs",
    "ota:prepare:dry-run": "node scripts/ota-prepare.mjs --dry-run",
    "ota:upload": "node scripts/ota-prepare.mjs",
    "ota:key:create": "npx --yes @capgo/cli@8.25.10 key create"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-updater": "^8.49.7",
    "cordova-plugin-purchase": "^13.17.2",
    "cordova-plugin-purchase-storekit2": "^1.0.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
