{
  "name": "synaplan-app",
  "version": "4.0.0",
  "private": true,
  "description": "Native iOS + Android shell for the Synaplan platform (Capacitor 8, bundled Vue SPA).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "./build.sh",
    "build:web": "./build.sh --web-only",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:ios": "cap run ios",
    "cap:android": "cap run android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "assets:generate": "capacitor-assets generate --ios --android --iconBackgroundColor '#003fc7' --iconBackgroundColorDark '#003fc7' --splashBackgroundColor '#003fc7' --splashBackgroundColorDark '#003fc7'",
    "ota:upload": "npx @capgo/cli@latest bundle upload --channel production --path synaplan/frontend/dist --bundle \"$npm_package_version\"",
    "ota:key:create": "npx @capgo/cli@latest key create"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-updater": "^8.49.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "typescript": "^6.0.3"
  }
}
