    "error.failed" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Synaplan konnte diesmal nicht antworten. Bitte versuche es erneut." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Synaplan couldn't answer this time. Please try again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Synaplan no pudo responder esta vez. Inténtalo de nuevo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Synaplan n'a pas pu répondre cette fois. Veuillez réessayer." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Synaplan bu kez yanıt veremedi. Lütfen tekrar dene." } }
      }
    },
    "error.limitReached" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Du hast dein Synaplan-Nutzungslimit vorerst erreicht." } },
