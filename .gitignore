# ──────────────────────────────────────────────────────────────────────────
# Capacitor / native build artifacts (Epic 1)
# ──────────────────────────────────────────────────────────────────────────

# @capacitor/assets byproducts we don't use (Epic 6): the apps-root PWA icon
# set + www/ are generator leftovers — our PWA icons live in the submodule.
# The committed deliverable is the native ios/ + android/ icon/splash sets and
# the source masters in assets/.
icons/
www/

# iOS
ios/App/Pods/
ios/App/build/
ios/App/output/
ios/App/App/public/
ios/DerivedData/
ios/capacitor-cordova-ios-plugins/
*.xcuserstate
*.xcworkspace/xcuserdata/

# Local xcodebuild output: -derivedDataPath (build-sim/, build-device/) and the
# archive/export directory. Release archives are built in CI under RUNNER_TEMP;
# a local .xcarchive carries the signed binary, dSYMs and the signing identity
# and must never be committed.
build-*/
build/

# Android
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.idea/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/

# Maestro native E2E artifacts (Gate 2) — screenshots/recordings from device runs.
# The flows themselves (.maestro/*.yaml) ARE committed; their output is not.
.maestro/artifacts/

# ──────────────────────────────────────────────────────────────────────────
# App store release area (_appstores/)
# The public part (icons, screenshots, listing texts) IS committed.
# _appstores/.local/ holds certificates, keys, passwords, account notes —
# NEVER committed (see docs/SECRETS.md and _appstores/README.md).
# ──────────────────────────────────────────────────────────────────────────
_appstores/.local/

# ──────────────────────────────────────────────────────────────────────────
# Secrets & signing (NEVER commit — see docs/SECRETS.md)
# ──────────────────────────────────────────────────────────────────────────
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
**/google-services.json
**/GoogleService-Info.plist
*-service-account*.json
fastlane/.env*
keystore.properties
# Capgo OTA signing private key (Epic 8) — public key is committed in capacitor.config.ts
.capgo_key
.capgo_key_v2
ios/App/App.xcodeproj/project.pbxproj
